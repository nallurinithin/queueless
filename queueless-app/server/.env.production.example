# QueueLess Backend Production Environment Configuration
PORT=3000
NODE_ENV=production

# MongoDB Production Connection (Local or Atlas Replica Set)
MONGODB_URI=mongodb://mongodb:27017/queueless_prod

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://aarogyam.clinic,http://localhost

# Session Security (Minimum 32 random bytes)
SESSION_SECRET=generate_strong_production_random_secret_here

# Razorpay Live API Credentials
RAZORPAY_MODE=live
RAZORPAY_LIVE_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_LIVE_KEY_SECRET=your_live_secret_key_here
RAZORPAY_LIVE_WEBHOOK_SECRET=your_live_webhook_secret_here

# Notification SMS Gateway (e.g. Kaleyra, Twilio, Gupshup)
SMS_GATEWAY_API_KEY=production_sms_key_here
SMS_SENDER_ID=ARGYAM

