{
  "name": "queueless-server",
  "version": "0.1.0",
  "private": true,
  "description": "QueueLess backend — Node/Express API server",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "cross-env NODE_ENV=production node src/index.js",
    "lint": "eslint src/ --ext .js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed-reset.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1",
    "vitest": "^3.2.1"
  }
}
