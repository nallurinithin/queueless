# ============================================================
# QueueLess Server Environment Variables (.env.example)
# ============================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Local MongoDB connection (replica set recommended for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/queueless_dev?directConnection=true

# --- Authentication & Session ---
# Secure secret for session/cookie signing (at least 32 characters)
SESSION_SECRET=change_me_to_a_secure_random_string_with_at_least_32_chars

# --- Logging ---
LOG_LEVEL=info

# --- OTP / Notification Provider (Placeholder for M2/M6) ---
# OTP_PROVIDER=mock
# SMS_API_KEY=your_sms_api_key_here
# WHATSAPP_API_KEY=your_whatsapp_api_key_here

# --- Payment Gateway (Placeholder for M5) ---
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=rzp_secret_placeholder
# RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

