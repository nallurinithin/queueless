# ============================================================
# QueueLess — Root .gitignore
# ============================================================

# --- Private documentation, journals, and progress trackers (Root only) ---
/QueueLess_Antigravity_Documentation/
/docs/
/decisions/
/PROJECT_STATUS.md
/CONTRIBUTING.md

# --- Binaries & Executable Tools ---
/bin/
*.exe
*.dll
*.so
*.dylib

# --- Dependencies & Directory Junctions ---
node_modules/
**/node_modules/

# --- Build & Bundle Output ---
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.cache/
**/.cache/
.vite/
**/.vite/

# --- Environment Configuration & Secrets ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
secrets/
credentials/

# --- Logs & Runtime State ---
*.log
logs/
**/logs/
.tmp/
temp/
**/temp/
uploads/
**/uploads/
storage/
**/storage/
data/
**/data/
mongodb/
*.dump

# --- IDE, Editor & OS Artifacts ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json

# --- Test Artifacts & Scratch Scripts ---
playwright-report/
**/playwright-report/
test-results/
**/test-results/
.last-run.json
**/.last-run.json
scratch/
**/scratch/

# --- Always preserve core documentation & manifests ---
!README.md
!**/README.md
!package.json
!**/package.json
!package-lock.json
!**/package-lock.json
