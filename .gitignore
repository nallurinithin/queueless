# ============================================================
# QueueLess — Root .gitignore
# ============================================================

# --- Documentation reference folder (not part of the app) ---
QueueLess_Antigravity_Documentation/

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build output ---
dist/
build/
coverage/
.cache/
.vite/

# --- Environment and secrets ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
secrets/
credentials/

# --- Logs and local data ---
*.log
logs/
.tmp/
temp/
uploads/
storage/
data/
mongodb/
*.dump

# --- IDE / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Test artifacts ---
playwright-report/
test-results/

# --- Private QueueLess development journal — NEVER COMMIT ---
/decisions/

